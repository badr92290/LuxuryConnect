generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  PROFESSIONAL
  ADMIN
}

enum ServiceType {
  PPF_SATIN
  PPF_COLORED
  PPF_GLOSS
  COVERING
  CERAMIC
  TINT

  // Valeurs historiques : plus proposées au client, conservées pour que les
  // demandes déjà enregistrées restent lisibles.
  PPF
  POLISH
}

// Cycle de vie d'une demande côté intermédiaire (admin) :
// PENDING_REVIEW -> l'admin vient de recevoir la demande du client
// FORWARDED      -> l'admin l'a transmise à un ou plusieurs professionnels
// QUOTED         -> au moins un professionnel a répondu avec un prix
// FINALIZED      -> l'admin a fixé le prix final et l'a envoyé au client
// ACCEPTED       -> le client a accepté l'offre finale (réservation créée)
// DECLINED       -> refusée par le client ou l'admin
// CANCELLED      -> annulée par le client
enum QuoteRequestStatus {
  PENDING_REVIEW
  FORWARDED
  QUOTED
  FINALIZED
  ACCEPTED
  DECLINED
  CANCELLED
}

enum QuoteForwardStatus {
  PENDING
  QUOTED
  DECLINED
}

enum QuoteStatus {
  PROPOSED
  SELECTED
  REJECTED
}

// Encaissement du client par LuxuryConnect.
enum PaymentStatus {
  PENDING // offre acceptée, paiement pas encore effectué
  PROCESSING // autorisation en cours chez la banque
  PAID // encaissé sur le compte LuxuryConnect
  FAILED
  REFUNDED
}

// Reversement de LuxuryConnect vers l'atelier. Il suit l'encaissement mais
// n'est déclenché qu'une fois la prestation réalisée : c'est ce décalage qui
// donne à l'intermédiaire les moyens de trancher un litige.
enum PayoutStatus {
  PENDING // prestation pas encore terminée, rien n'est versé
  SCHEDULED // versement demandé
  PAID // viré sur le compte de l'atelier
  FAILED
}

enum BookingStatus {
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum NotificationType {
  REQUEST_RECEIVED
  REQUEST_FORWARDED
  QUOTE_RECEIVED
  OFFER_SENT
  OFFER_ACCEPTED
  OFFER_DECLINED
  QUOTE_REMINDER
  CONTACT_LEAD
  PAYMENT_RECEIVED
  PAYMENT_FAILED
  PAYOUT_SENT
  PAYOUT_PENDING
  SUPPORT_OPENED
  SUPPORT_REPLY
  SUPPORT_REMINDER
  SUPPORT_ESCALATED
  SUPPORT_RESOLVED
}

// Le SAV est la seule partie du service où le client et l'atelier se parlent
// directement : une fois la prestation réalisée, l'intermédiaire n'a plus de
// prix à fixer, et faire transiter un défaut constaté par un tiers ne ferait
// que rallonger le délai. LuxuryConnect reste joignable en renfort.
enum SupportTicketStatus {
  OPEN // ouvert par le client, l'atelier n'a pas encore répondu
  IN_PROGRESS // l'atelier a répondu, l'échange est en cours
  ESCALATED // l'assistance LuxuryConnect a été appelée en renfort
  RESOLVED // clos par le client ou par l'assistance
}

enum SupportTicketReason {
  DEFECT // défaut constaté sur la pose
  WARRANTY // mise en jeu de la garantie
  APPOINTMENT // rendez-vous, retouche, planning
  INVOICE // facture, paiement
  OTHER
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role
  firstName    String
  lastName     String
  phone        String?
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  professionalProfile ProfessionalProfile?

  quoteRequests    QuoteRequest[]   @relation("ClientQuoteRequests")
  bookingsAsClient Booking[]        @relation("ClientBookings")
  reviewsWritten   Review[]         @relation("ClientReviews")
  supportTickets   SupportTicket[]  @relation("ClientTickets")
  payments         Payment[]        @relation("ClientPayments")
  supportMessages  SupportMessage[] @relation("SupportMessages")
  vehicles         Vehicle[]        @relation("ClientVehicles")

  conversationsAsA Conversation[] @relation("ConversationA")
  conversationsAsB Conversation[] @relation("ConversationB")
  messagesSent     Message[]      @relation("SentMessages")
  notifications    Notification[]
}

// Demande de contact déposée depuis le site public, sans création de compte.
model ContactLead {
  id          String       @id @default(uuid())
  firstName   String
  lastName    String
  email       String
  phone       String?
  serviceType ServiceType?
  message     String?
  city        String?
  handledAt   DateTime?
  createdAt   DateTime     @default(now())
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String?
  // Chemin dans l'application vers l'élément concerné
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
}

model ProfessionalProfile {
  id            String  @id @default(uuid())
  userId        String  @unique
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName  String
  description   String?
  address       String?
  city          String?
  latitude      Float?
  longitude     Float?
  averageRating Float   @default(0)
  reviewCount   Int     @default(0)

  // Gages de confiance affichés au client
  isInsured       Boolean @default(false)
  isCertified     Boolean @default(false)
  yearsExperience Int?

  // Compte Stripe Connect de l'atelier. LuxuryConnect encaisse le client,
  // puis vire la part de l'atelier sur ce compte : les pièces d'identité et
  // le RIB restent chez Stripe, jamais dans notre base.
  stripeAccountId      String?   @unique
  stripePayoutsEnabled Boolean   @default(false)
  stripeOnboardedAt    DateTime?

  // Site vitrine du professionnel, d'où sont importées ses réalisations.
  // L'import n'a lieu que si le professionnel a confirmé détenir les droits.
  websiteUrl             String?
  websiteRightsConfirmed Boolean   @default(false)
  websiteImportedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services            ProfessionalService[]
  portfolioImages     PortfolioImage[]
  quoteForwards       QuoteForward[]
  quotes              Quote[]
  bookings            Booking[]             @relation("ProBookings")
  reviews             Review[]              @relation("ProReviews")
  supportTickets      SupportTicket[]       @relation("ProTickets")
  payments            Payment[]             @relation("ProPayments")
  selectedForRequests QuoteRequest[]        @relation("SelectedProfessional")
}

model ProfessionalService {
  id             String              @id @default(uuid())
  professionalId String
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  serviceType    ServiceType
  priceFrom      Float?
  description    String?

  @@unique([professionalId, serviceType])
}

model PortfolioImage {
  id             String              @id @default(uuid())
  professionalId String
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  imageUrl       String
  caption        String?
  isBeforeAfter  Boolean             @default(false)
  // Renseigné quand l'image vient d'un import depuis le site du professionnel,
  // ce qui permet d'éviter les doublons lors d'un réimport.
  sourceUrl      String?
  createdAt      DateTime            @default(now())

  @@unique([professionalId, sourceUrl])
}

// Véhicule enregistré dans le garage d'un client, réutilisable d'une demande à l'autre.
model Vehicle {
  id        String   @id @default(uuid())
  ownerId   String
  owner     User     @relation("ClientVehicles", fields: [ownerId], references: [id], onDelete: Cascade)
  make      String
  model     String
  year      Int?
  plate     String?
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quoteRequests QuoteRequest[]
}

model QuoteRequestPhoto {
  id             String       @id @default(uuid())
  quoteRequestId String
  quoteRequest   QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  imageUrl       String
  createdAt      DateTime     @default(now())
}

model QuoteRequest {
  id          String      @id @default(uuid())
  clientId    String
  client      User        @relation("ClientQuoteRequests", fields: [clientId], references: [id], onDelete: Cascade)
  serviceType ServiceType

  // Le véhicule est recopié sur la demande (historique figé) et peut pointer
  // vers une fiche du garage quand le client en a sélectionné une.
  vehicleId    String?
  vehicle      Vehicle?           @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  vehicleMake  String
  vehicleModel String
  vehicleYear  Int?
  description  String?
  city         String?
  status       QuoteRequestStatus @default(PENDING_REVIEW)

  // Fixés par l'admin lors de la finalisation
  selectedProfessionalId String?
  selectedProfessional   ProfessionalProfile? @relation("SelectedProfessional", fields: [selectedProfessionalId], references: [id])
  finalPrice             Float?
  finalMessage           String?
  adminNote              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  forwards QuoteForward[]
  quotes   Quote[]
  booking  Booking?
  photos   QuoteRequestPhoto[]
}

// Trace qu'une demande a été transmise par l'admin à un professionnel donné
model QuoteForward {
  id             String              @id @default(uuid())
  quoteRequestId String
  quoteRequest   QuoteRequest        @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  professionalId String
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  status         QuoteForwardStatus  @default(PENDING)
  createdAt      DateTime            @default(now())

  @@unique([quoteRequestId, professionalId])
}

// Prix proposé par un professionnel à l'admin (jamais visible directement par le client)
model Quote {
  id             String              @id @default(uuid())
  quoteRequestId String
  quoteRequest   QuoteRequest        @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  professionalId String
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  price          Float
  message        String?
  status         QuoteStatus         @default(PROPOSED)
  createdAt      DateTime            @default(now())
}

model Booking {
  id             String              @id @default(uuid())
  quoteRequestId String              @unique
  quoteRequest   QuoteRequest        @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  clientId       String
  client         User                @relation("ClientBookings", fields: [clientId], references: [id], onDelete: Cascade)
  professionalId String
  professional   ProfessionalProfile @relation("ProBookings", fields: [professionalId], references: [id], onDelete: Cascade)
  price          Float
  scheduledAt    DateTime
  status         BookingStatus       @default(CONFIRMED)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  review         Review?
  supportTickets SupportTicket[]
  payment        Payment?
}

// Un paiement porte les deux mouvements d'argent d'une prestation : ce que le
// client verse à LuxuryConnect, et ce que LuxuryConnect reverse à l'atelier.
// La différence est notre rémunération, et le client ne la voit jamais — il ne
// connaît que `amountTotal`.
//
// Les montants sont en centimes : un flottant ne sait pas représenter 0,10 €
// exactement, et une facture ne tolère pas l'à-peu-près.
model Payment {
  id             String              @id @default(uuid())
  bookingId      String              @unique
  booking        Booking             @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  clientId       String
  client         User                @relation("ClientPayments", fields: [clientId], references: [id], onDelete: Cascade)
  professionalId String
  professional   ProfessionalProfile @relation("ProPayments", fields: [professionalId], references: [id], onDelete: Cascade)

  amountTotal    Int // ce que paie le client
  amountWorkshop Int // ce que touche l'atelier
  amountMargin   Int // amountTotal - amountWorkshop
  currency       String @default("eur")

  status                PaymentStatus @default(PENDING)
  stripePaymentIntentId String?       @unique
  stripeChargeId        String?
  // « Apple Pay », « Google Pay », « Visa •••• 4242 » — pour le reçu.
  paymentMethodLabel    String?
  paidAt                DateTime?
  refundedAt            DateTime?
  failureMessage        String?

  payoutStatus     PayoutStatus @default(PENDING)
  stripeTransferId String?
  paidOutAt        DateTime?
  payoutError      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([payoutStatus])
}

// Dossier de service après-vente, rattaché à une prestation réalisée.
// Le fil de discussion lui est propre : il relie directement le client et
// l'atelier, alors que le modèle `Conversation` relie toujours quelqu'un à
// l'intermédiaire.
model SupportTicket {
  id             String              @id @default(uuid())
  bookingId      String
  booking        Booking             @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  clientId       String
  client         User                @relation("ClientTickets", fields: [clientId], references: [id], onDelete: Cascade)
  professionalId String
  professional   ProfessionalProfile @relation("ProTickets", fields: [professionalId], references: [id], onDelete: Cascade)

  reason  SupportTicketReason
  subject String
  status  SupportTicketStatus @default(OPEN)

  // Horodatages qui pilotent l'automatisation : relance de l'atelier resté
  // muet, escalade vers l'assistance, clôture.
  firstResponseAt DateTime?
  lastReminderAt  DateTime?
  escalatedAt     DateTime?
  resolvedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages SupportMessage[]
  photos   SupportTicketPhoto[]

  @@index([status, createdAt])
  @@index([professionalId, status])
}

model SupportMessage {
  id        String        @id @default(uuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User          @relation("SupportMessages", fields: [senderId], references: [id], onDelete: Cascade)
  content   String
  // Message posté par le système (ouverture, relance, escalade) plutôt que
  // par une personne : affiché différemment dans le fil.
  isSystem  Boolean       @default(false)
  createdAt DateTime      @default(now())

  @@index([ticketId, createdAt])
}

model SupportTicketPhoto {
  id        String        @id @default(uuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  imageUrl  String
  createdAt DateTime      @default(now())
}

model Review {
  id             String              @id @default(uuid())
  bookingId      String              @unique
  booking        Booking             @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  clientId       String
  client         User                @relation("ClientReviews", fields: [clientId], references: [id], onDelete: Cascade)
  professionalId String
  professional   ProfessionalProfile @relation("ProReviews", fields: [professionalId], references: [id], onDelete: Cascade)
  rating         Int
  comment        String?
  // Un avis est visible publiquement par défaut ; l'admin peut le retirer de la vitrine.
  published      Boolean             @default(true)
  createdAt      DateTime            @default(now())

  @@index([published, createdAt])
}

// Conversation générique entre deux utilisateurs (client <-> admin, ou admin <-> professionnel).
// participantAId est toujours l'id le plus petit lexicographiquement pour garantir l'unicité.
model Conversation {
  id             String   @id @default(uuid())
  participantAId String
  participantA   User     @relation("ConversationA", fields: [participantAId], references: [id], onDelete: Cascade)
  participantBId String
  participantB   User     @relation("ConversationB", fields: [participantBId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  messages Message[]

  @@unique([participantAId, participantBId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  content        String
  createdAt      DateTime     @default(now())
}
