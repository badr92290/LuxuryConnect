# Base de données PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/luxuryconnect

# Signature des jetons d'authentification. À générer aléatoirement et à ne
# jamais committer : ce secret ne doit exister que dans l'hébergeur.
JWT_SECRET=
JWT_EXPIRES_IN=7d

PORT=4000

# En production : force HTTPS, active HSTS et restreint les origines CORS.
NODE_ENV=production

# Origines autorisées à appeler l'API, séparées par des virgules.
# Vide en production = aucune origine externe autorisée.
CORS_ORIGINS=https://luxuryconnect.fr,https://www.luxuryconnect.fr

# ── Paiement (Stripe) ────────────────────────────────────────────────────
# Le client paie LuxuryConnect ; LuxuryConnect reverse ensuite sa part à
# l'atelier via Stripe Connect. Sans ces clés, l'application fonctionne mais
# les écrans de paiement affichent « non configuré ».
#
# Clé secrète du compte LuxuryConnect (sk_test_… en test, sk_live_… en prod).
STRIPE_SECRET_KEY=
# Secret de signature du webhook, donné par Stripe à la création du endpoint
# (https://votre-api/stripe/webhook). Sans lui, aucun paiement n'est validé.
STRIPE_WEBHOOK_SECRET=
# Adresse du site, vers laquelle Stripe renvoie l'atelier après son inscription.
APP_BASE_URL=https://luxuryconnect.fr
