# Adresse de l'API. Le front-end n'embarque aucun secret : il ne connaît que
# cette URL publique, et s'authentifie avec le jeton de la personne connectée.
VITE_API_BASE_URL=https://api.luxuryconnect.fr

# Domaine public du site, utilisé pour les liens canoniques et les métadonnées
# de partage. Sans barre oblique finale.
VITE_SITE_URL=https://luxuryconnect.fr

# Mesure d'audience sans cookie (Plausible, Umami, Matomo…). Laisser vide
# désactive complètement la mesure et masque la bannière de consentement.
VITE_ANALYTICS_SRC=
VITE_ANALYTICS_DOMAIN=

# Clé publique Stripe (pk_test_… puis pk_live_…). Elle est destinée au
# navigateur : ce n'est pas un secret. Vide = paiement en ligne désactivé.
VITE_STRIPE_PUBLISHABLE_KEY=
